{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_space.v1.json",
  "title": "FeatureSpaceDescriptor",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "feature_space_id",
    "feature_space_type",
    "producer",
    "producer_version",
    "model_id",
    "layer_map",
    "dim",
    "activation_rule",
    "checksum"
  ],
  "properties": {
    "schema_name": { "const": "feature_space.v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "feature_space_id": { "type": "string", "minLength": 1 },
    "feature_space_type": { "type": "string", "minLength": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "producer_version": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "layer_map": { "type": "object" },
    "dim": { "type": "integer", "minimum": 1 },
    "activation_rule": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
