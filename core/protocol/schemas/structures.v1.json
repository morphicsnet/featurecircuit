{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structures.v1.json",
  "title": "StructureArtifact",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "structure_builder_type",
    "structure_builder_version",
    "structures"
  ],
  "properties": {
    "schema_name": { "const": "structures.v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "structure_builder_type": { "type": "string", "minLength": 1 },
    "structure_builder_version": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["structure_id", "structure_type", "members", "arity"],
        "properties": {
          "structure_id": { "type": "string", "minLength": 1 },
          "structure_type": { "type": "string", "minLength": 1 },
          "members": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "arity": { "type": "integer", "minimum": 1 },
          "support_count": { "type": "integer", "minimum": 0 },
          "stability_score": { "type": "number" },
          "synergy_score": { "type": "number" },
          "threshold": { "type": "number" },
          "scale": { "type": "number" },
          "filtration_value": { "type": "number" },
          "construction_rule": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
