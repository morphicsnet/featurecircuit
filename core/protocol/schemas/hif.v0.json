{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hif.v0.json",
  "title": "CanonicalHIFv0",
  "type": "object",
  "required": ["schema", "nodes", "hyperedges"],
  "properties": {
    "schema": { "const": "HIF-v0" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "hyperedges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nodes", "count"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "nodes": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
