{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_events.v1.jsonl",
  "title": "FeatureEvent",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "event_id",
    "source_kind",
    "feature_space_id",
    "feature_space_version",
    "sample_id",
    "token_index",
    "layer",
    "node_type",
    "node_id",
    "value",
    "step_index"
  ],
  "properties": {
    "schema_name": { "const": "feature_events.v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "source_kind": {
      "type": "string",
      "enum": ["mock", "hf_local", "api_trace", "posthoc_import", "hardware_capture"]
    },
    "feature_space_id": { "type": "string", "minLength": 1 },
    "feature_space_version": { "type": "string", "minLength": 1 },
    "sample_id": { "type": ["string", "integer"] },
    "sequence_id": { "type": ["string", "integer"] },
    "doc_id": { "type": ["string", "integer"] },
    "token_index": { "type": "integer", "minimum": 0 },
    "layer": { "type": "integer" },
    "node_type": { "type": "string", "minLength": 1 },
    "node_id": { "type": ["string", "integer"] },
    "value": { "type": "number" },
    "step_index": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string" },
    "dictionary_id": { "type": "string" },
    "dictionary_version": { "type": "string" },
    "dictionary_type": { "type": "string" },
    "feature_origin_layer": { "type": "integer" },
    "member_key": { "type": "string" },
    "feature_key": { "type": "string" },
    "candidate_key": { "type": "string" },
    "task_family": { "type": "string" },
    "prompt_family": { "type": "string" },
    "split": { "type": "string" },
    "label": { "type": "string" },
    "capability_tag": { "type": "string" },
    "safety_tag": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
